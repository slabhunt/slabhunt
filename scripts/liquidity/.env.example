# Copy to .env (never commit it). Start on devnet.
CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
# Hot wallet that pays fees and holds tokens while seeding. Never owns positions.
OPERATOR_KEYPAIR=./keys/operator.json

# Squads multisig vault addresses (create these first)
LIQUIDITY_MULTISIG=
SECONDARY_RESERVE_WALLET=
GAME_TREASURY_WALLET=
TEAM_VESTING_WALLET=

# Filled in after create-token
TOKEN_MINT=
# When trading opens (UTC)
LAUNCH_TIME=2026-11-01T17:00:00Z

# METADATA_URI=https://vault-hunt.vercel.app/brand/yoink.json
# DRY_RUN=1
# REVOKE=0

# Logo/metadata hosting: set to pin on IPFS through Pinata instead of Arweave
# PINATA_JWT=
# PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
