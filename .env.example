# Copy to .env.local and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# No longer needed: players explore by tapping the map (explorer mode).
# Also raise game_config.max_speed_mps in the database while testing this way.
VITE_ALLOW_SIMULATED_LOCATION=false
